
-- AFSSController.lua
-- Place this script inside ServerScriptService.
-- Handles the full SOP: Detect -> Verify -> Dispatch/Navigate -> Suppress -> Log

--   1. Pls name a part "Robot" in Workspace with a Humanoid and a PrimaryPart
--   2. A RemoteEvent will be auto-created in ReplicatedStorage named "AFSSUpdate" 


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")

-- config 
local VERIFICATION_CHECKS = 2        -- number of consecutive checks required to confirm a fire
local CHECK_INTERVAL = 0.75          -- seconds between each verification check
local SUPPRESSION_RATE = 10          -- how much "Intensity" drops per second once suppression starts
local TRIAL_TIME_LIMIT = 30          -- seconds; if fire isn't contained by then, trial is marked failed

-- remote event setup
local remoteEvent = ReplicatedStorage:FindFirstChild("AFSSUpdate")
if not remoteEvent then
	remoteEvent = Instance.new("RemoteEvent")
	remoteEvent.Name = "AFSSUpdate"
	remoteEvent.Parent = ReplicatedStorage
end

-- robot ref
local robot = workspace:WaitForChild("Robot")
local robotRoot = robot.PrimaryPart or robot:WaitForChild("HumanoidRootPart")
local humanoid = robot:WaitForChild("Humanoid")

local trialActive = false

local function updateUI(stage, data)
	data = data or {}
	remoteEvent:FireAllClients(stage, data)
end

-- STAGE 3 HELPER: move the robot along a computed path
local function moveRobotTo(targetPosition)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
	})

	local ok, err = pcall(function()
		path:ComputeAsync(robotRoot.Position, targetPosition)
	end)

	if not ok or path.Status ~= Enum.PathStatus.Success then
		warn("AFSS: pathfinding failed - " .. tostring(err))
		return false, 0
	end

	local waypoints = path:GetWaypoints()
	local pathLength = 0
	local lastPos = robotRoot.Position

	for _, waypoint in ipairs(waypoints) do
		pathLength += (waypoint.Position - lastPos).Magnitude
		lastPos = waypoint.Position

		humanoid:MoveTo(waypoint.Position)
		local reached = humanoid.MoveToFinished:Wait()
		if not reached then
			warn("AFSS: robot failed to reach a waypoint")
			return false, pathLength
		end
	end

	return true, pathLength
end

-- main trial runner
-- Call runTrial(firePart) to start one full SOP cycle on a given fire Part.
-- The fire Part needs a numeric attribute called "Intensity" (e.g. 100 = full fire).
local function runTrial(firePart)
	if trialActive then
		warn("AFSS: a trial is already running")
		return
	end
	trialActive = true

	-- STAGE 1: SENSE (Detection)
	local t0 = os.clock()
	updateUI("DETECTED", { zone = firePart.Name })

	-- STAGE 2: VERIFY 
	local confirmedCount = 0
	for _ = 1, VERIFICATION_CHECKS do
		task.wait(CHECK_INTERVAL)
		local stillBurning = firePart and firePart.Parent and (firePart:GetAttribute("Intensity") or 0) > 0
		if stillBurning then
			confirmedCount += 1
		end
	end

	if confirmedCount < VERIFICATION_CHECKS then
		updateUI("FALSE_POSITIVE", {})
		trialActive = false
		return
	end

	local tConfirm = os.clock()
	updateUI("CONFIRMED", {})

	-- STAGE 3: PLAN (Decision & Navigation) 
	local t1 = os.clock() -- dispatch time
	updateUI("DISPATCHED", { responseTime = t1 - t0 })

	local reached, pathLength = moveRobotTo(firePart.Position)
	local t2 = os.clock() -- arrival time

	if not reached then
		updateUI("SUPPRESSION_FAILED", { outcome = "Mission Incomplete", reason = "Navigation failed" })
		trialActive = false
		return
	end

	-- straight-line distance, used to compute Navigation Efficiency
	local straightLineDistance = (firePart.Position - robotRoot.Position).Magnitude
	local navigationEfficiency = 1
	if pathLength > 0 then
		navigationEfficiency = straightLineDistance / pathLength
	end

	updateUI("ARRIVED", {})

	-- STAGE 4: ACT (Suppression)
	local startIntensity = firePart:GetAttribute("Intensity") or 100
	local currentIntensity = startIntensity
	local suppressionStart = os.clock()
	local contained = false

	while os.clock() - suppressionStart < TRIAL_TIME_LIMIT do
		task.wait(1)
		currentIntensity = math.max(0, currentIntensity - SUPPRESSION_RATE)
		firePart:SetAttribute("Intensity", currentIntensity)
		updateUI("SUPPRESSING", { intensity = currentIntensity })

		if currentIntensity <= 0 then
			contained = true
			break
		end
	end

	local t3 = os.clock()

	-- STAGE 5: LOG 
	if contained then
		updateUI("CONTAINED", {
			responseTime = t1 - t0,
			timeToContainment = t3 - t2,
			areaBurned = startIntensity - currentIntensity,
			navigationEfficiency = navigationEfficiency,
			outcome = "Mission Complete",
		})
	else
		updateUI("SUPPRESSION_FAILED", {
			responseTime = t1 - t0,
			outcome = "Mission Incomplete",
			reason = "Time limit exceeded before containment",
		})
	end

	trialActive = false
end

_G.RunAFSSTrial = runTrial
